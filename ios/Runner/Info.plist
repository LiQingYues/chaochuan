<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>$(LX_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(LX_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(LX_BUILD_NUMBER)</string>
	<!-- 开发模式（LXAppHost）：Debug 配置为 YES（Debug.xcconfig）；模拟器直接读电脑上的源码目录（LX/Generated.xcconfig） -->
	<key>LXDevelopment</key>
	<string>$(LX_DEVELOPMENT)</string>
	<key>LXDevFrameworkDir</key>
	<string>$(LX_DEV_FRAMEWORK_DIR)</string>
	<key>LXDevAppDir</key>
	<string>$(LX_DEV_APP_DIR)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>用于拍照、录像和扫码</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于录音和录制视频声音</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择照片和视频</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于保存图片和视频到相册</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于获取你所在的位置</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>用于在后台持续获取位置</string>
	<key>NSContactsUsageDescription</key>
	<string>用于读取通讯录</string>
	<key>NSCalendarsUsageDescription</key>
	<string>用于读取和添加日历事件</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>用于读取和添加日历事件</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>用于添加日历事件</string>
	<key>NSRemindersUsageDescription</key>
	<string>用于读取和添加提醒事项</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>用于读取和添加提醒事项</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于连接蓝牙设备</string>
	<key>NSMotionUsageDescription</key>
	<string>用于统计步数和运动状态</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于语音转文字</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>用于向你提供更相关的内容</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>用于访问你的媒体资料库</string>
	<key>NSFaceIDUsageDescription</key>
	<string>用于面容 ID 验证身份</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>wechat</string>
		<string>alipay</string>
		<string>alipays</string>
		<string>mqq</string>
		<string>mqqapi</string>
		<string>sinaweibo</string>
		<string>taobao</string>
		<string>tmall</string>
		<string>openapp.jdmobile</string>
		<string>snssdk1128</string>
		<string>orpheus</string>
		<string>baidumap</string>
		<string>iosamap</string>
		<string>comgooglemaps</string>
		<string>itms-apps</string>
	</array>
	<!-- 超传：局域网发现 / 收发（iOS 14+ 首次访问局域网弹「本地网络」权限；没有这段说明系统直接拒绝） -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>超传需要访问本地网络，用来发现附近的设备并收发文件。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_localsend._tcp</string>
	</array>
	<!-- 收到的文件存在 App 的 Documents/超传，在「文件」App →「我的 iPhone」→ 超传 里能看到 -->
	<!-- 分享面板 / 「文件」App 里「用超传打开」：CFBundleDocumentTypes（下面）+ 原地打开；进来的文件见 AppDelegate.m -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>任意文件</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
				<string>public.content</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>lx.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>chaochuan</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
