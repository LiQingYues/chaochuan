<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(LX_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(LX_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(LX_BUILD_NUMBER)</string>
	<!-- 开发模式（LXAppHost）：Debug 配置为 YES（Debug.xcconfig），直接读电脑上的源码目录（LX/Generated.xcconfig） -->
	<key>LXDevelopment</key>
	<string>$(LX_DEVELOPMENT)</string>
	<key>LXDevFrameworkDir</key>
	<string>$(LX_DEV_FRAMEWORK_DIR)</string>
	<key>LXDevAppDir</key>
	<string>$(LX_DEV_APP_DIR)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSArchitecturePriority</key>
	<array>
		<string>arm64</string>
	</array>
	<key>LSRequiresNativeExecution</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>任意文件或文件夹</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lx.hello</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>chaochuan</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>用于拍照、扫码</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于录音</string>
	<key>NSLocationUsageDescription</key>
	<string>用于获取当前位置</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于获取当前位置</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于选择和保存图片</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于保存图片到照片</string>
	<key>NSContactsUsageDescription</key>
	<string>用于读取通讯录</string>
	<key>NSCalendarsUsageDescription</key>
	<string>用于读写日历</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>用于读写日历</string>
	<key>NSRemindersUsageDescription</key>
	<string>用于读写提醒事项</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>用于读写提醒事项</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>用于连接蓝牙设备</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于语音识别</string>
</dict>
</plist>
