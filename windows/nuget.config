<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet 包还原到 windows/packages（packages.config 模式，Runner.vcxproj 按这个目录 Import） -->
<configuration>
  <config>
    <add key="repositoryPath" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
